	measure UnitMargin = SUM('ds_product'[profit_amount]) / SUM('ds_product'[quantity])
		lineageTag: c82f1548-85c6-41f9-9c5c-b85fadd855cd

	measure 'Units Sold' = SUM('ds_product'[quantity])
