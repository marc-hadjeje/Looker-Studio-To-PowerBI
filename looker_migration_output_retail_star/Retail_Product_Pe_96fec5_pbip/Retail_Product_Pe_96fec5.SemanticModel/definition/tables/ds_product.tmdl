		lineageTag: 040dec65-873c-48f0-9a39-4ca7da831aae

	partition ds_product = m
		mode: import
		source = ```
			let
			    Source = GoogleBigQuery.Database(),
			    Data = Value.NativeQuery(Source, "SELECT d.full_date AS sales_date, p.product_name, p.category, p.subcategory, p.brand, f.quantity, f.net_sales_amount, f.cost_amount, f.profit_amount FROM `ferrous-gate-496806-b7.retail_star.fact_sales` f JOIN `ferrous-gate-496806-b7.retail_star.dim_date` d ON f.date_key = d.date_key JOIN `ferrous-gate-496806-b7.retail_star.dim_product` p ON f.product_key = p.product_key")
			in
			    Data
			```

