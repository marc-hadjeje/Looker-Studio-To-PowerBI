	partition ds_product = m
		mode: import
		source = ```
			let
			    Source = GoogleBigQuery.Database([BillingProject = "ferrous-gate-496806-b7"]),
			    Project = Source{[Name = "ferrous-gate-496806-b7"]}[Data],
			    Data = Value.NativeQuery(Project, "SELECT d.full_date AS sales_date, p.product_name, p.category, p.subcategory, p.brand, f.quantity, f.net_sales_amount, f.cost_amount, f.profit_amount FROM `ferrous-gate-496806-b7.retail_star.fact_sales` f JOIN `ferrous-gate-496806-b7.retail_star.dim_date` d ON f.date_key = d.date_key JOIN `ferrous-gate-496806-b7.retail_star.dim_product` p ON f.product_key = p.product_key", null, [EnableFolding = false])
			in
			    Data
			```

