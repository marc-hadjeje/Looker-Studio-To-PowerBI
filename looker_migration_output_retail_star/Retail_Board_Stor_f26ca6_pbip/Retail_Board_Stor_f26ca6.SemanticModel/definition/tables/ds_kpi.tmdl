	measure MarginPct = SUM('ds_kpi'[profit_amount]) / SUM('ds_kpi'[net_sales_amount])
		lineageTag: ddc43028-75da-4671-bc9a-1e9c790bfa4e

	measure AverageOrderValue = SUM('ds_kpi'[net_sales_amount]) / DISTINCTCOUNT('ds_kpi'[order_id])
		lineageTag: 62ff2d21-ff26-4e72-99b6-1588ab18de7c

	measure DiscountRate = SUM('ds_kpi'[discount_amount]) / SUM('ds_kpi'[gross_amount])
		lineageTag: 3d443baa-fca0-496e-b2fa-58db1b4589e0

	measure ProfitPerUnit = SUM('ds_kpi'[profit_amount]) / SUM('ds_kpi'[quantity])
