	measure 'Net Sales' = SUM('ds_kpi'[net_sales_amount])
		lineageTag: e0a7790e-daed-4516-ac1f-abbf32673b65

	measure Profit = SUM('ds_kpi'[profit_amount])
		lineageTag: 2b95b776-4533-42bd-97a5-1dbe1400abdf

	measure 'Margin %' = SUM('ds_kpi'[profit_amount])/SUM('ds_kpi'[net_sales_amount])
		lineageTag: 87d2ac2e-6401-42f9-b695-63bb1e7eed1d

	measure 'Net Sales Trend' = SUM('ds_kpi'[net_sales_amount])
