	measure 'Profit Trend' = SUM('ds_kpi'[profit_amount])
		lineageTag: e64f998d-430f-4c41-a772-0adeab81adae

	measure 'Sales by Category' = SUM('ds_kpi'[net_sales_amount])
		lineageTag: 8d5044d5-ad3a-4889-99d0-1bb2c79f4170

	measure 'Channel Mix' = SUM('ds_kpi'[net_sales_amount])
		lineageTag: c0354555-b00c-4a68-a901-1b2ea9bf3567

	measure 'Profit by Segment' = SUM('ds_kpi'[profit_amount])
		lineageTag: 2b870bde-4274-4cbe-be8f-5768d2128457

	measure 'Margin by Region' = SUM('ds_kpi'[profit_amount])/SUM('ds_kpi'[net_sales_amount])
		lineageTag: a75d162c-55d3-4b1b-bfb2-17da7d7aa823

	measure 'Loyalty vs Non-Loyalty Sales' = SUM('ds_kpi'[net_sales_amount])
		lineageTag: 8197fada-81bd-48c8-b6ab-77847e4bc445

	measure 'Store Format Profit' = SUM('ds_kpi'[profit_amount])
		lineageTag: 30bbe694-7b26-4cb6-9068-319b5dcb315b

