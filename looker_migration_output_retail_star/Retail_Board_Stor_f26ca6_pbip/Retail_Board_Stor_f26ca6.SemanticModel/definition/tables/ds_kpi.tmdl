		lineageTag: 1f456844-6f22-4c13-9a6e-5aae37acba0f

	partition ds_kpi = m
		mode: import
		source = ```
			let
			    Source = GoogleBigQuery.Database(),
			    Data = Value.NativeQuery(Source, "WITH base AS ( SELECT d.full_date AS sales_date, d.year, d.month, p.category, p.brand, c.segment, c.is_loyalty_member, s.region AS store_region, s.store_format, ch.channel_name, f.order_id, f.quantity, f.gross_amount, f.discount_amount, f.net_sales_amount, f.cost_amount, f.profit_amount FROM `ferrous-gate-496806-b7.retail_star.fact_sales` f JOIN `ferrous-gate-496806-b7.retail_star.dim_date` d ON f.date_key = d.date_key JOIN `ferrous-gate-496806-b7.retail_star.dim_product` p ON f.product_key = p.product_key JOIN `ferrous-gate-496806-b7.retail_star.dim_customer` c ON f.customer_key = c.customer_key JOIN `ferrous-gate-496806-b7.retail_star.dim_store` s ON f.store_key = s.store_key JOIN `ferrous-gate-496806-b7.retail_star.dim_channel` ch ON f.channel_key = ch.channel_key ) SELECT * FROM base")
			in
			    Data
			```

