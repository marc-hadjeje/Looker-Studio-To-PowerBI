	measure ActualMarginPct = SUM('ds_actuals_bq'[profit_amount]) / SUM('ds_actuals_bq'[net_sales_amount])
		lineageTag: 29ed6f4f-7c96-4db8-98f1-5b90c0513f9c

	measure TargetAttainmentPlaceholder = SUM('ds_actuals_bq'[net_sales_amount]) / SUM('ds_actuals_bq'[target_sales])
		lineageTag: 94b132ad-5881-49f3-9a05-4aaac4292cf9

	measure 'Actual Net Sales' = SUM('ds_actuals_bq'[net_sales_amount])
		lineageTag: 6f4ac05a-b435-491e-b331-247eedbb2b49

	measure 'Actual Profit' = SUM('ds_actuals_bq'[profit_amount])
		lineageTag: f0a553e3-a4de-4892-b929-4e654a6e100c

	measure 'Actual Trend' = SUM('ds_actuals_bq'[net_sales_amount])
		lineageTag: 83143fb1-1754-4809-bf51-79a4ab73ed80

	measure 'Actual by Region' = SUM('ds_actuals_bq'[net_sales_amount])
		lineageTag: ba7ddb89-0afe-4254-bff5-413ae2726b73

	measure 'Variance Waterfall Placeholder' = SUM('ds_actuals_bq'[net_sales_amount])
		lineageTag: 32cbefc8-9f46-49a7-a31c-4a0490a7cd68

	partition ds_actuals_bq = m
		mode: import
		source = ```
			let
			    Source = GoogleBigQuery.Database(),
			    Data = Value.NativeQuery(Source, "SELECT d.full_date AS sales_date, d.month, d.month_name, s.region AS store_region, p.category, ch.channel_name, f.order_id, f.net_sales_amount, f.profit_amount FROM `ferrous-gate-496806-b7.retail_star.fact_sales` f JOIN `ferrous-gate-496806-b7.retail_star.dim_date` d ON f.date_key = d.date_key JOIN `ferrous-gate-496806-b7.retail_star.dim_store` s ON f.store_key = s.store_key JOIN `ferrous-gate-496806-b7.retail_star.dim_product` p ON f.product_key = p.product_key JOIN `ferrous-gate-496806-b7.retail_star.dim_channel` ch ON f.channel_key = ch.channel_key")
			in
			    Data
			```

