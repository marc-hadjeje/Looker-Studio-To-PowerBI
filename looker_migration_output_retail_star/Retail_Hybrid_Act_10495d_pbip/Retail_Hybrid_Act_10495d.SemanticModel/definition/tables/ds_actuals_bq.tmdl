	partition ds_actuals_bq = m
		mode: import
		source = ```
			let
			    Source = GoogleBigQuery.Database([BillingProject = "ferrous-gate-496806-b7"]),
			    Project = Source{[Name = "ferrous-gate-496806-b7"]}[Data],
			    Data = Value.NativeQuery(Project, "SELECT d.full_date AS sales_date, d.month, d.month_name, s.region AS store_region, p.category, ch.channel_name, f.order_id, f.net_sales_amount, f.profit_amount FROM `ferrous-gate-496806-b7.retail_star.fact_sales` f JOIN `ferrous-gate-496806-b7.retail_star.dim_date` d ON f.date_key = d.date_key JOIN `ferrous-gate-496806-b7.retail_star.dim_store` s ON f.store_key = s.store_key JOIN `ferrous-gate-496806-b7.retail_star.dim_product` p ON f.product_key = p.product_key JOIN `ferrous-gate-496806-b7.retail_star.dim_channel` ch ON f.channel_key = ch.channel_key", null, [EnableFolding = false])
			in
			    Data
			```

