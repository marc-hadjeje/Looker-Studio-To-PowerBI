	measure ActualMarginPct = SUM('ds_actuals_bq'[profit_amount]) / SUM('ds_actuals_bq'[net_sales_amount])
		lineageTag: d14c6116-21ff-40eb-8b44-129be75c0a1f

	measure TargetAttainmentPlaceholder = SUM('ds_actuals_bq'[net_sales_amount]) / SUM('ds_actuals_bq'[target_sales])
		lineageTag: 7ee8cc25-bbe8-4368-98f3-636c197ec448

	measure 'Actual Net Sales' = SUM('ds_actuals_bq'[net_sales_amount])
		lineageTag: f72c213b-69ff-4026-867e-375224e54f92

	measure 'Actual Profit' = SUM('ds_actuals_bq'[profit_amount])
