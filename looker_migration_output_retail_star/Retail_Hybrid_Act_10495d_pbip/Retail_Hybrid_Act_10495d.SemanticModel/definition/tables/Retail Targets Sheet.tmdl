	column target_sales
		dataType: double
		summarizeBy: sum
		sourceColumn: target_sales
		lineageTag: 232c647d-dec9-49b7-9b02-572d4011cbaa

	measure ActualMarginPct = SUM('Retail Targets Sheet'[profit_amount]) / SUM('Retail Targets Sheet'[net_sales_amount])
		lineageTag: 09110c6f-94d4-43b9-8562-d69ea0c9b883

	measure TargetAttainmentPlaceholder = SUM('Retail Targets Sheet'[net_sales_amount]) / SUM('Retail Targets Sheet'[target_sales])
		lineageTag: dab1fcaf-8eff-4f59-9cce-3d4f1cba3d03

	measure 'Target by Region' = SUM('Retail Targets Sheet'[target_sales])
		lineageTag: 6c0f4018-1ff8-4b0f-b496-5896f6a75ce0

	measure 'Target by Category' = SUM('Retail Targets Sheet'[target_sales])
		lineageTag: 309e129a-a861-4414-9f66-66818e72e1bf

	partition 'Retail Targets Sheet' = m
		mode: import
		source = ```
			let
			    Source = #table({}, {})
