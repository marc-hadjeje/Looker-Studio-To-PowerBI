		summarizeBy: sum
		sourceColumn: profit_amount
		lineageTag: 750f2b98-00c6-46a0-a959-9d2f11ea4f8e

	column net_sales_amount
		dataType: double
		summarizeBy: sum
		sourceColumn: net_sales_amount
