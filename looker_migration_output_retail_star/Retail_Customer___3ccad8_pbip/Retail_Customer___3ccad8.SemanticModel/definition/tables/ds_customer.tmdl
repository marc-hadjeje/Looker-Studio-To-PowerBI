	partition ds_customer = m
		mode: import
		source = ```
			let
			    Source = GoogleBigQuery.Database([BillingProject = "ferrous-gate-496806-b7"]),
			    Project = Source{[Name = "ferrous-gate-496806-b7"]}[Data],
			    Data = Value.NativeQuery(Project, "SELECT d.full_date AS sales_date, c.customer_id, c.segment, c.region AS customer_region, c.age_group, c.is_loyalty_member, ch.channel_name, s.store_format, f.order_id, f.quantity, f.net_sales_amount, f.profit_amount FROM `ferrous-gate-496806-b7.retail_star.fact_sales` f JOIN `ferrous-gate-496806-b7.retail_star.dim_date` d ON f.date_key = d.date_key JOIN `ferrous-gate-496806-b7.retail_star.dim_customer` c ON f.customer_key = c.customer_key JOIN `ferrous-gate-496806-b7.retail_star.dim_store` s ON f.store_key = s.store_key JOIN `ferrous-gate-496806-b7.retail_star.dim_channel` ch ON f.channel_key = ch.channel_key", null, [EnableFolding = false])
			in
			    Data
			```

